# Configure these as environment variables in PHP-FPM/Apache, outside the public web root.
# This example is documentation; PHP does not read .env files automatically.
HEPSO_PUBLIC_ORIGIN=https://hepso.com.br
HEPSO_SMTP_HOST=smtp.hepso.com.br
HEPSO_SMTP_PORT=587
HEPSO_SMTP_USER=comercial@hepso.com.br
HEPSO_SMTP_PASS=
HEPSO_HR_EMAIL=
HEPSO_CLAMAV_SOCKET=unix:///run/clamav/clamd.ctl
