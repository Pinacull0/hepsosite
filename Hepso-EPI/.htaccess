# ============ Evitar 500 quando modulos nè´™o existem ============
<IfModule mod_mime.c>
  AddType application/wasm         .wasm
  AddType application/json         .json
  AddType text/javascript          .js
  AddType text/css                 .css
  AddType image/svg+xml            .svg
</IfModule>

# alguns servidores tratam incorretamente .map
<IfModule mod_mime.c>
  AddType application/octet-stream .map
</IfModule>

# Desliga MultiViews (evita 404/500 em rotas SPA)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# ============ Single Page App fallback ============
<IfModule mod_rewrite.c>
  RewriteEngine On
  # ajuste se seu app estiver em subdiretè´—rio (ex: /app/)
  RewriteBase /

  # Se o arquivo existir, serve-o
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Caso contrè´°rio, encaminha para index.html (rotas do React)
  RewriteRule . /index.html [L]
</IfModule>

# ============ Seguranè´Æa e CSP sem quebrar o Supabase ============
<IfModule mod_headers.c>
  # Permite chamadas ao seu projeto Supabase (troque o ref!)
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://zqcbzhitbesypltduntg.supabase.co https://*.supabase.co https://*.supabase.in; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Evita bloqueio de fontes/imagens cross-origin
  Header always set Cross-Origin-Resource-Policy "cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  # Cache estè´°tico bè´°sico (opcional)

</IfModule>

# Evita que o PHP tente interpretar arquivos estè´°ticos (em alguns hosts isso causa 500)
<IfModule mod_mime.c>
  RemoveType .php
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
